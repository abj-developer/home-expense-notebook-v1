{
  "name": "home-expense-notebook",
  "version": "1.0.0",
  "private": true,
  "description": "Home Expense Notebook - Angular 22 with JSON Server mock API",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "mock-api": "json-server db.json --host 0.0.0.0 --port 3000",
    "mock-api:prod": "json-server db.json --host 0.0.0.0 --port $PORT"
  },
  "dependencies": {
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/platform-browser-dynamic": "22.1.5",
    "@angular/router": "22.1.5",
    "@supabase/supabase-js": "^2.117.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.5",
    "json-server": "1.0.0-beta.15",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
